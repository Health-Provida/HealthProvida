{
  "name": "@healthprovida/monorepo",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "turbo run dev",
    "dev:patient": "pnpm --filter @healthprovida/patient-portal run dev",
    "dev:lab": "pnpm --filter @healthprovida/lab-portal run dev",
    "dev:super-admin": "pnpm --filter @healthprovida/super-admin-portal run dev",
    "build": "turbo run build",
    "build:vercel": "turbo run build && mkdir -p apps/patient-portal/dist/lab && cp -r apps/lab-portal/dist/* apps/patient-portal/dist/lab/",
    "build:patient": "turbo run build --filter=@healthprovida/patient-portal",
    "build:lab": "turbo run build --filter=@healthprovida/lab-portal",
    "build:super-admin": "turbo run build --filter=@healthprovida/super-admin-portal",
    "lint": "turbo run lint",
    "lint:patient": "turbo run lint --filter=@healthprovida/patient-portal",
    "lint:lab": "turbo run lint --filter=@healthprovida/lab-portal",
    "lint:super-admin": "turbo run lint --filter=@healthprovida/super-admin-portal",
    "typecheck": "turbo run typecheck",
    "preview": "turbo run preview"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
